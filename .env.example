# ─── api-node · variables de entorno ─────────────────────────────────────────
# Copia este archivo a .env y ajusta los valores. Obligatoria: JWT_SECRET.

# Puerto HTTP del servicio
PORT=3000

# JWT (HS256) emitido por api-go. JWT_SECRET, JWT_ISSUER y JWT_AUDIENCE DEBEN coincidir con los de api-go.
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-o-mas
JWT_ISSUER=api-go
JWT_AUDIENCE=matrix-services

# Orígenes permitidos por CORS (separados por coma), p. ej. el frontend Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Valor absoluto bajo el cual un número se considera cero al evaluar si una matriz es diagonal
DIAGONAL_TOLERANCE=1e-10
# Límites de entrada
MATRIX_MAX_DIMENSION=100
MAX_MATRICES=10
BODY_LIMIT=1mb

# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
